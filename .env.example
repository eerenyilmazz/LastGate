# AdMob App IDs — set these in EAS Secrets or your local .env
# Get IDs from: https://apps.admob.com
ADMOB_ANDROID_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_IOS_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# Sentry — set in EAS Secrets for production crash reporting
# DSN: Project Settings → Client Keys
SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX
# Auth Token: sentry.io → Settings → Auth Tokens → Create New Token (project:releases scope)
SENTRY_AUTH_TOKEN=sntrys_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
